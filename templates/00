{% extends "base.html" %}
{% block content %}

<!DOCTYPE html>
<html>
<head>
    <title>Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>

<body class="bg-light">

    <div class="container py-3" style="max-width: 1100px;">

        <!-- Dashboard Header -->
        <div class="text-center" style="margin-top: 10px; margin-bottom: 55px;">

            <!-- Title + Icon -->
            <div class="d-flex justify-content-center align-items-center mb-2">
                <i class="bi bi-activity" style="font-size: 42px; color: #0d6efd; margin-right: 12px;"></i>
                <h1 class="fw-bold" style="font-size: 44px; margin: 0;">Performance Dashboard</h1>
            </div>

            <!-- Thin Divider Line -->
            <hr style="width: 65%; margin: 18px auto; border-top: 1px solid #bbb;">

            <!-- Date Range + Refresh -->
            <div class="d-flex justify-content-center gap-3 mt-3">

                <!-- Date Range Selector -->
                <select class="form-select w-auto shadow-sm" style="font-size: 14px; padding: 6px 30px;">
                    <option>Last 7 days</option>
                    <option selected>Last 30 days</option>
                    <option>Last 90 days</option>
                    <option>Year to Date</option>
                    <option>All Time</option>
                </select>

                <!-- Refresh Button -->
                <button onclick="location.reload()" 
                        class="btn btn-primary shadow-sm" 
                        style="font-size: 14px; padding: 6px 14px;">
                    <i class="bi bi-arrow-clockwise me-1"></i> Refresh Data
                </button>

            </div>

        </div>



        {% if plateau %}
        <div class="alert alert-warning text-center py-2">
            ⚠️ Plateau detected: moving average has not increased.
        </div>
        {% endif %}

        <!-- Summary Row -->
        <div class="row text-center mb-3 g-3">
            <div class="col-md-3">
                <div class="p-3 bg-white shadow-sm rounded">
                    <h6 class="text-muted">Total Workouts</h6>
                    <h4>{{ volumes|length }}</h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-white shadow-sm rounded">
                    <h6 class="text-muted">Avg Volume</h6>
                    <h4>{{ (volumes|sum / (volumes|length if volumes|length > 0 else 1))|round(1) }}</h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-white shadow-sm rounded">
                    <h6 class="text-muted">Top Category</h6>
                    <h4>{{ categories[0] if categories else "N/A" }}</h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-white shadow-sm rounded">
                    <h6 class="text-muted">Last Workout</h6>
                    <h4>{{ dates[-1] if dates else "N/A" }}</h4>
                </div>
            </div>
        </div>

        <!-- Two charts side by side -->
        <div class="row g-3">

            <!-- Left: Volume Chart -->
            <div class="col-md-7">
                <div class="card shadow-sm" style="border-radius: 10px;">
                    <div class="card-body p-3">
                        <h6 class="text-center mb-2">Training Volume Over Time</h6>
                        <div style="height: 320px;">
                            <canvas id="volumeChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Pie Chart -->
            <div class="col-md-5">
                <div class="card shadow-sm" style="border-radius: 10px;">
                    <div class="card-body p-3">
                        <h6 class="text-center mb-2">Exercise Category Distribution</h6>
                        <div style="height: 320px;">
                            <canvas id="categoryChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="text-center mt-4">
            <a href="/user/{{ user_id }}" class="btn btn-outline-secondary btn-lg">
            Back to User
            </a>
        </div>

    </div>

    <script>
        const dates = JSON.parse('{{ dates | tojson | safe }}');
        const volumes = JSON.parse('{{ volumes | tojson | safe }}');
        const movingAvg = JSON.parse('{{ moving_avg | tojson | safe }}');
        const categories = JSON.parse('{{ categories | tojson | safe }}');
        const categoryCounts = JSON.parse('{{ category_counts | tojson | safe }}');

        new Chart(document.getElementById('volumeChart'), {
            type: 'line',
            data: {
                labels: dates,
                datasets: [
                    {
                        label: 'Volume',
                        data: volumes,
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13,110,253,0.15)',
                        fill: true,
                        tension: 0.3,
                        borderWidth: 2
                    },
                    {
                        label: 'Moving Avg',
                        data: movingAvg,
                        borderColor: '#dc3545',
                        borderDash: [5, 5],
                        fill: false,
                        tension: 0.3,
                        borderWidth: 2
                    }
                ]
            },
            options: {
                plugins: { legend: { display: false }},
                maintainAspectRatio: false
            }
        });

        new Chart(document.getElementById('categoryChart'), {
            type: 'pie',
            data: {
                labels: categories,
                datasets: [{
                    data: categoryCounts,
                    backgroundColor: [
                        '#0d6efd',
                        '#198754',
                        '#ffc107',
                        '#dc3545',
                        '#6f42c1'
                    ]
                }]
            },
            options: {
                plugins: { legend: { position: 'bottom' }},
                maintainAspectRatio: false
            }
        });
    </script>

</body>
</html>
{% endblock %}